# Copy to .env and fill in locally. Never commit .env.

# --- SerpApi (required for live searches) ---
SERPAPI_API_KEY=
# true = serve searches from backend/fixtures/serpapi instead of the live API
MOCK_SERPAPI=false
SERPAPI_TIMEOUT_SECONDS=20
SERPAPI_MAX_RETRIES=2
SERPAPI_BACKOFF_SECONDS=1.0
SERPAPI_DEFAULT_GL=in
SERPAPI_DEFAULT_HL=en

# --- Search budget ---
MAX_SEARCHES_PER_INVESTIGATION=3
MAX_RESULTS_PER_SEARCH=10
# Follow-up planner: at most this many reason-coded follow-up searches (also capped by the total above)
PLANNER_ENABLED=true
MAX_FOLLOW_UP_SEARCHES=2

# --- Cache (avoids repeat API spend during development) ---
SERPAPI_CACHE_ENABLED=true
SERPAPI_CACHE_TTL_HOURS=24
# SERPAPI_CACHE_DIR=data/cache/serpapi

# --- Storage ---
# DATABASE_PATH=data/civicsignal.sqlite3
# SERPAPI_FIXTURES_DIR=backend/fixtures/serpapi

# --- Staleness severity thresholds ---
# HIGH: expired > STALENESS_HIGH_DAYS and ranked at position <= STALENESS_HIGH_MAX_POSITION
# MEDIUM: expired > STALENESS_MEDIUM_DAYS; LOW otherwise
STALENESS_HIGH_DAYS=60
STALENESS_HIGH_MAX_POSITION=5
STALENESS_MEDIUM_DAYS=14

# --- LLM (optional; the pipeline runs fully without it) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

LOG_LEVEL=INFO
